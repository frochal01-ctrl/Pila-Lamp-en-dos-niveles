Vagrant.configure("2") do |config|

  config.vm.box = "debian/bookworm64"

  config.vm.define "apache" do |apache|
    apache.vm.hostname = "FranciscoRochaApache"
    apache.vm.network "forwarded_port", guest: 80, host: 8080, host_ip: "127.0.0.1"
    apache.vm.network "private_network", ip: "192.168.56.10", virtualbox__intnet: "dos_niveles"
    apache.vm.provision "shell", path: "papache.sh"

    apache.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"
      vb.cpus = 1
    end
  end

  config.vm.define "mysql" do |mysql|
    mysql.vm.hostname = "FranciscoRochaMysql"
    mysql.vm.network "private_network", ip: "192.168.56.20", virtualbox__intnet: "dos_niveles"
    mysql.vm.provision "shell", path: "pmysql.sh"

    mysql.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"
      vb.cpus = 1
    end

    # CORRECCIÓN: Al pasar |t, machine|, la variable 'machine.id' sí es válida
    mysql.trigger.after :up do |t, machine|
      t.run = { inline: "VBoxManage controlvm #{machine.id} setlinkstate1 off" }
    end
  end

end





